JWT_KEY=replace-with-jwt-key
POSTGRES_DB=innoviahub
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-postgres-password
AI_API_KEY=replace_with_your_openai_api_key

# Admin skapas automatiskt om kontot saknas.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-strong-admin-password

# Produktionsversionens adress
APP_DOMAIN=innovia.example.com
PUBLIC_API_URL=https://innovia.example.com

# IoT styrs vid frontendbygget.
# Produktionsfilen sätter VITE_IOT_ENABLED=false.
# Vid lokal Vite-körning kan VITE_IOT_ENABLED=false anges
# i frontend/.env.development för att stänga av IoT.
# Om inställningen saknas är IoT aktiverat.
